{
  "name": "assayer",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "assayer": "dist/bin/assayer.js"
  },
  "files": [
    "dist",
    "!dist/package.json"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build-workspaces.mjs --tsc-only",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "postbuild": "chmod +x dist/bin/*.js 2>/dev/null || true",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@assayer/bin": "*",
    "@assayer/core": "*",
    "@assayer/desktop": "*",
    "@assayer/node": "*",
    "@assayer/npm": "*",
    "@assayer/shared": "*",
    "zod": "^4.6.5"
  },
  "imports": {
    "#gateway/npm/*": "@assayer/npm/*",
    "#gateway/node/*": "@assayer/node/*",
    "#gateway/browser/*": "@assayer/browser/*",
    "#gateway/bin/*": "@assayer/bin/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    }
  }
}
