{
  "name": "@assayer/shared",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    },
    "./contracts": {
      "source": "./src/contracts/contracts.ts",
      "types": "./dist/src/contracts/contracts.d.ts",
      "import": "./dist/src/contracts/contracts.js",
      "require": "./dist/src/contracts/contracts.js"
    },
    "./transformers": {
      "source": "./src/transformers/transformers.ts",
      "types": "./dist/src/transformers/transformers.d.ts",
      "import": "./dist/src/transformers/transformers.js",
      "require": "./dist/src/transformers/transformers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@assayer/npm": "*",
    "zod": "^4.6.5"
  },
  "imports": {
    "#gateway/npm/*": "@assayer/npm/*",
    "#gateway/node/*": "@assayer/node/*",
    "#gateway/browser/*": "@assayer/browser/*",
    "#gateway/bin/*": "@assayer/bin/*"
  }
}
