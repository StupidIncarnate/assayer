{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./.ward/build.tsbuildinfo",
    "customConditions": ["gateway-dist", "source"]
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.integration.test.ts",
    "**/*.proxy.ts",
    "**/*.stub.ts",
    "**/*.harness.ts",
    "src/.test-tmp/**",
    "src/_lint-testbed/**"
  ]
}
