{
  "name": "@assayer/hydration-recipes",
  "version": "0.1.0",
  "description": "hydration-recipes package",
  "private": true,
  "imports": {
    "#gateway/npm/*": "@assayer/npm/*",
    "#gateway/node/*": "@assayer/node/*",
    "#gateway/browser/*": "@assayer/browser/*",
    "#gateway/bin/*": "@assayer/bin/*"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./package.json": "./package.json",
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    },
    "./responders": {
      "source": "./src/responders/responders.ts",
      "types": "./dist/src/responders/responders.d.ts",
      "import": "./dist/src/responders/responders.js",
      "require": "./dist/src/responders/responders.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
