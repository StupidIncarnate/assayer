{
  "name": "@assayer/app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:clean": "rm -rf dist && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@assayer/bin": "*",
    "@assayer/browser": "*",
    "@assayer/node": "*",
    "@assayer/npm": "*",
    "@assayer/shared": "*",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/view": "^6.34.1",
    "@mantine/core": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@uiw/react-codemirror": "^4.23.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^4.6.5"
  },
  "imports": {
    "#gateway/npm/*": "@assayer/npm/*",
    "#gateway/node/*": "@assayer/node/*",
    "#gateway/browser/*": "@assayer/browser/*",
    "#gateway/bin/*": "@assayer/bin/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    }
  }
}
