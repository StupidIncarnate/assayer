{
  "name": "@assayer/core",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters": {
      "source": "./adapters.ts",
      "import": "./dist/adapters.js",
      "require": "./dist/adapters.js",
      "types": "./dist/adapters.d.ts"
    },
    "./brokers": {
      "source": "./brokers.ts",
      "import": "./dist/brokers.js",
      "require": "./dist/brokers.js",
      "types": "./dist/brokers.d.ts"
    },
    "./contracts": {
      "source": "./contracts.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    },
    "./transformers": {
      "source": "./transformers.ts",
      "import": "./dist/transformers.js",
      "require": "./dist/transformers.js",
      "types": "./dist/transformers.d.ts"
    },
    "./testing": {
      "source": "./testing.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@assayer/bin": "*",
    "@assayer/node": "*",
    "@assayer/npm": "*",
    "@assayer/shared": "*",
    "@jest/core": "^30.0.4",
    "jest": "^30.0.4",
    "ts-jest": "^29.4.0",
    "ts-morph": "^26.0.0",
    "typescript": "^5.8.3",
    "zod": "^4.6.5"
  },
  "imports": {
    "#gateway/npm/*": "@assayer/npm/*",
    "#gateway/node/*": "@assayer/node/*",
    "#gateway/browser/*": "@assayer/browser/*",
    "#gateway/bin/*": "@assayer/bin/*"
  }
}
