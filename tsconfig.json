{
  "extends": "@legendscribe/lockdown-kit-eslint-plugin/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "sourceMap": true,
    "types": [
      "*"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/*.ts"
  ]
}
