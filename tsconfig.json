{
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "customConditions": ["source"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/*.ts"
  ],
  "extends": "./tsconfig.base.json"
}
