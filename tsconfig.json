{
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/desktop"
    },
    {
      "path": "./packages/cli"
    }
  ],
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/*.ts"
  ],
  "extends": "./tsconfig.base.json"
}
