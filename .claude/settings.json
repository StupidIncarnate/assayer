{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-pre-edit-lint"
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-pre-bash"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Search|Find",
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-pre-search"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-pre-folder-detail"
          }
        ]
      },
      {
        "matcher": "mcp__lockdown-kit__.*",
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-pre-mcp-caller"
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "brutalpit-pre-bash"
          }
        ]
      },
      {
        "matcher": "mcp__brutalpit__.*",
        "hooks": [
          {
            "type": "command",
            "command": "brutalpit-pre-mcp-caller"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-post-bash",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet discover"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet searchStrategy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet reportingFindings"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet folderTypes"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet modifyingCodeGuidance"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet ward"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet wardDiscipline"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet packages"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet backgroundTasks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet commentDiscipline"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet buildDiscipline"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet worktrees"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet generatedConfig"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet siegelense"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet consumerGatewayWrapper"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet decisionMaking"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet discover"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet searchStrategy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet reportingFindings"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet folderTypes"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet modifyingCodeGuidance"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet ward"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet wardDiscipline"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet packages"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet backgroundTasks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet commentDiscipline"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet buildDiscipline"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet worktrees"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet generatedConfig"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet siegelense"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet consumerGatewayWrapper"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-session-snippet decisionMaking"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lockdown-kit-worktree-create"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "mcp__claude-in-chrome",
      "Bash(curl:*)",
      "Bash(kill:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(python3:*)",
      "mcp__lockdown-kit__discover",
      "mcp__lockdown-kit__get-architecture",
      "mcp__lockdown-kit__get-folder-detail",
      "mcp__lockdown-kit__get-testing-patterns",
      "mcp__lockdown-kit__get-project-map",
      "mcp__lockdown-kit__get-project-inventory",
      "mcp__lockdown-kit__create-worktree",
      "Bash(lockdown-kit siegelense:*)",
      "mcp__brutalpit__get-quest",
      "mcp__brutalpit__modify-quest",
      "mcp__brutalpit__signal-back",
      "mcp__brutalpit__start-quest",
      "mcp__brutalpit__get-quest-status",
      "mcp__brutalpit__list-quests",
      "mcp__brutalpit__list-guilds",
      "mcp__brutalpit__ask-user-question",
      "mcp__brutalpit__get-agent-prompt",
      "mcp__brutalpit__get-quest-planning-notes",
      "mcp__brutalpit__get-blight-checklist",
      "mcp__brutalpit__get-server-config",
      "mcp__brutalpit__get-quest-summary",
      "mcp__brutalpit__quest-work",
      "mcp__brutalpit__get-quest-work",
      "mcp__brutalpit__get-quest-health"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "crossSessionInbound": "refuse",
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "promptSuggestionEnabled": false
}
