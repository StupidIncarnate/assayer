{
  "name": "@assayer/monorepo",
  "version": "1.0.0",
  "description": "Test enforcement + generation for TypeScript repos, maintained by LLMs.",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/@gateway/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs && node scripts/copy-dist-package-json.mjs",
    "build:clean": "rm -rf packages/*/dist packages/*/.ward/build.tsbuildinfo packages/@gateway/*/dist packages/@gateway/*/.ward/build.tsbuildinfo && npm run build",
    "dev:stop": "pkill -f '[d]esktop-main.js' || true; fuser -k 6273/tcp >/dev/null 2>&1 || true; wait-on -r -t 5000 tcp:127.0.0.1:6273",
    "predev": "npm run dev:stop",
    "dev": "npm run build && node packages/cli/dist/bin/assayer.js status && concurrently -k -n tsc-shared,tsc-core,tsc-desktop,tsc-cli,app,desktop -c gray,gray,gray,gray,blue,green \"tsc -p packages/shared/tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p packages/core/tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p packages/desktop/tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p packages/cli/tsconfig.build.json --watch --preserveWatchOutput\" \"npm run dev -w @assayer/app\" \"wait-on tcp:127.0.0.1:6273 && npm run dev -w @assayer/desktop\"",
    "ward": "node node_modules/@legendscribe/lockdown-kit-ward/dist/bin/ward-entry.js",
    "lint": "node node_modules/@legendscribe/lockdown-kit-ward/dist/bin/ward-entry.js --only lint",
    "typecheck": "node node_modules/@legendscribe/lockdown-kit-ward/dist/bin/ward-entry.js --only typecheck",
    "test": "node node_modules/@legendscribe/lockdown-kit-ward/dist/bin/ward-entry.js --only test",
    "test:syntax": "jest --config manual-smoke-repo/packages/syntax-repository/jest.config.js",
    "typecheck:syntax": "npm run typecheck --prefix manual-smoke-repo",
    "generate:specimens": "tsx --conditions=source packages/specimen-generator/bin/specimen-generator-entry.ts",
    "test:generated": "jest --config smoke-repo/packages/syntax-repository/jest.config.js",
    "typecheck:generated": "npm run typecheck --prefix smoke-repo",
    "test:eslint-rules": "jest --config eslint-rules/jest.config.js",
    "postinstall": "if command -v lockdown-kit >/dev/null 2>&1; then lockdown-kit gateway-sync; fi",
    "init": "lockdown-kit init && brutalpit init",
    "siegelense": "lockdown-kit siegelense"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@legendscribe/brutalpit-bin": "file:../brutalpit/packages/@gateway/bin",
    "@legendscribe/brutalpit-browser": "file:../brutalpit/packages/@gateway/browser",
    "@legendscribe/brutalpit-chronicle-llm": "file:../brutalpit/packages/chronicle-llm",
    "@legendscribe/brutalpit-cli": "file:../brutalpit/packages/cli",
    "@legendscribe/brutalpit-hooks": "file:../brutalpit/packages/hooks",
    "@legendscribe/brutalpit-mcp": "file:../brutalpit/packages/mcp",
    "@legendscribe/brutalpit-node": "file:../brutalpit/packages/@gateway/node",
    "@legendscribe/brutalpit-npm": "file:../brutalpit/packages/@gateway/npm",
    "@legendscribe/brutalpit-orchestrator": "file:../brutalpit/packages/orchestrator",
    "@legendscribe/brutalpit-server": "file:../brutalpit/packages/server",
    "@legendscribe/brutalpit-shared": "file:../brutalpit/packages/shared",
    "@legendscribe/brutalpit-ui-elements": "file:../brutalpit/packages/ui-elements",
    "@legendscribe/brutalpit-web": "file:../brutalpit/packages/web",
    "@legendscribe/lockdown-kit-bin": "file:../lockdown-kit/packages/@gateway/bin",
    "@legendscribe/lockdown-kit-browser": "file:../lockdown-kit/packages/@gateway/browser",
    "@legendscribe/lockdown-kit-cli": "file:../lockdown-kit/packages/cli",
    "@legendscribe/lockdown-kit-config": "file:../lockdown-kit/packages/config",
    "@legendscribe/lockdown-kit-eslint-plugin": "file:../lockdown-kit/packages/eslint-plugin",
    "@legendscribe/lockdown-kit-hooks": "file:../lockdown-kit/packages/hooks",
    "@legendscribe/lockdown-kit-hydration": "file:../lockdown-kit/packages/hydration",
    "@legendscribe/lockdown-kit-load-balancer": "file:../lockdown-kit/packages/load-balancer",
    "@legendscribe/lockdown-kit-mcp": "file:../lockdown-kit/packages/mcp",
    "@legendscribe/lockdown-kit-node": "file:../lockdown-kit/packages/@gateway/node",
    "@legendscribe/lockdown-kit-npm": "file:../lockdown-kit/packages/@gateway/npm",
    "@legendscribe/lockdown-kit-shared": "file:../lockdown-kit/packages/shared",
    "@legendscribe/lockdown-kit-siegelense": "file:../lockdown-kit/packages/siegelense",
    "@legendscribe/lockdown-kit-testing": "file:../lockdown-kit/packages/testing",
    "@legendscribe/lockdown-kit-tooling": "file:../lockdown-kit/packages/tooling",
    "@legendscribe/lockdown-kit-ward": "file:../lockdown-kit/packages/ward",
    "@legendscribe/lockdown-kit-worktree": "file:../lockdown-kit/packages/worktree",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/prettier": "^2.7.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "~8.58.2",
    "@typescript-eslint/parser": "~8.58.2",
    "@typescript-eslint/rule-tester": "~8.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
