{
  "name": "@assayer/monorepo",
  "version": "1.0.0",
  "description": "Test enforcement + generation for TypeScript repos, maintained by LLMs.",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/@gateway/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs && node scripts/copy-dist-package-json.mjs",
    "build:clean": "rm -rf packages/*/dist packages/*/.ward/build.tsbuildinfo packages/@gateway/*/dist packages/@gateway/*/.ward/build.tsbuildinfo && npm run build",
    "dev:stop": "pkill -f '[d]esktop-main.js' || true; fuser -k 6273/tcp >/dev/null 2>&1 || true; wait-on -r -t 5000 tcp:127.0.0.1:6273",
    "predev": "npm run dev:stop",
    "dev": "npm run build && node packages/cli/dist/bin/assayer.js status && concurrently -k -n tsc-shared,tsc-core,tsc-desktop,tsc-cli,app,desktop -c gray,gray,gray,gray,blue,green \"tsc -p packages/shared/tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p packages/core/tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p packages/desktop/tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p packages/cli/tsconfig.build.json --watch --preserveWatchOutput\" \"npm run dev -w @assayer/app\" \"wait-on tcp:127.0.0.1:6273 && npm run dev -w @assayer/desktop\"",
    "ward": "dungeonmaster-ward",
    "lint": "dungeonmaster-ward --only lint",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "test": "dungeonmaster-ward --only test",
    "test:syntax": "jest --config manual-smoke-repo/packages/syntax-repository/jest.config.js",
    "typecheck:syntax": "npm run typecheck --prefix manual-smoke-repo",
    "generate:specimens": "tsx --conditions=source packages/specimen-generator/bin/specimen-generator-entry.ts",
    "test:generated": "jest --config smoke-repo/packages/syntax-repository/jest.config.js",
    "typecheck:generated": "npm run typecheck --prefix smoke-repo",
    "test:eslint-rules": "jest --config eslint-rules/jest.config.js",
    "postinstall": "if command -v dungeonmaster >/dev/null 2>&1; then dungeonmaster gateway-sync; fi"
  },
  "devDependencies": {
    "@dungeonmaster/cli": "file:../codex-of-consentient-craft/packages/cli",
    "@dungeonmaster/config": "file:../codex-of-consentient-craft/packages/config",
    "@dungeonmaster/eslint-plugin": "file:../codex-of-consentient-craft/packages/eslint-plugin",
    "@dungeonmaster/hooks": "file:../codex-of-consentient-craft/packages/hooks",
    "@dungeonmaster/local-eslint": "file:../codex-of-consentient-craft/packages/local-eslint",
    "@dungeonmaster/mcp": "file:../codex-of-consentient-craft/packages/mcp",
    "@dungeonmaster/orchestrator": "file:../codex-of-consentient-craft/packages/orchestrator",
    "@dungeonmaster/server": "file:../codex-of-consentient-craft/packages/server",
    "@dungeonmaster/shared": "file:../codex-of-consentient-craft/packages/shared",
    "@dungeonmaster/siegelense": "file:../codex-of-consentient-craft/packages/siegelense",
    "@dungeonmaster/testing": "file:../codex-of-consentient-craft/packages/testing",
    "@dungeonmaster/tooling": "file:../codex-of-consentient-craft/packages/tooling",
    "@dungeonmaster/ward": "file:../codex-of-consentient-craft/packages/ward",
    "@dungeonmaster/web": "file:../codex-of-consentient-craft/packages/web",
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/prettier": "^2.7.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "~8.58.2",
    "@typescript-eslint/parser": "~8.58.2",
    "@typescript-eslint/rule-tester": "~8.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
