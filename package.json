{
  "name": "assayer-monorepo",
  "version": "1.0.0",
  "description": "Test enforcement + generation for TypeScript repos, maintained by LLMs.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json && npm run build -w @assayer/app",
    "dev": "npm run build -w @assayer/desktop && concurrently -k -n app,desktop -c blue,green \"npm run dev -w @assayer/app\" \"wait-on tcp:127.0.0.1:6273 && npm run dev -w @assayer/desktop\"",
    "ward": "dungeonmaster-ward",
    "lint": "dungeonmaster-ward --only lint",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "test": "dungeonmaster-ward --only test"
  },
  "devDependencies": {
    "@dungeonmaster/eslint-plugin": "*",
    "@dungeonmaster/hooks": "*",
    "@dungeonmaster/mcp": "*",
    "@dungeonmaster/shared": "*",
    "@dungeonmaster/testing": "*",
    "@dungeonmaster/ward": "*",
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.58.2",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/prettier": "^2.7.3",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.4",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.3",
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "jest-environment-jsdom": "^30.0.0",
    "electron": "^32.1.0",
    "tsup": "^8.2.4",
    "ts-morph": "^26.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}