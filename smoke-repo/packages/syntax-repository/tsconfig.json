{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    // The one `.tsx` rung needs JSX typed, so the automatic runtime is on and its element types
    // resolve through `react`'s own — no other specimen touches JSX, so this is otherwise inert.
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "baseUrl": ".",
    // The specimens import the analyzer the way a consumer would, by package subpath. These paths
    // are the ONLY definition of where those subpaths resolve: jest.config.js derives its
    // moduleNameMapper from them, so the runtime and the typechecker cannot disagree.
    //
    // Mapped straight at core: a shim file here would become part of the analyzed surface itself.
    "paths": {
      "@assayer/core/extract-analysis": [
        "../../../packages/core/src/brokers/analyze/extract/analyze-extract-broker"
      ],
      // Specimens that assert DARK SPOTS need the full file analysis, which is a projection of a
      // WALK rather than of source — so they need the walk adapter alongside the broker.
      "@assayer/core/walk-file": [
        "../../../packages/core/src/brokers/file/walk/file-walk-broker"
      ],
      "@assayer/core/analyze-file": ["../../../packages/core/src/brokers/analyze/file/analyze-file-broker"],
      // The cross-file predicate compose is a CONSUME-TIME overlay applied on top of a file analysis,
      // so a specimen asserting composed guards imports it beside the analyze-file broker.
      "@assayer/core/compose-cross-file": [
        "../../../packages/core/src/brokers/compose/cross-file-predicates/compose-cross-file-predicates-broker"
      ],
      // The cross-file MAP fold is the other consume-time overlay: a surface mapping an imported
      // function over an array param folds that sibling callee's branches into the host, so a specimen
      // asserting the folded funnel imports it beside the analyze-file broker.
      "@assayer/core/compose-cross-file-map": [
        "../../../packages/core/src/brokers/compose/cross-file-map/compose-cross-file-map-broker"
      ],
      // Object-arrange (stub-realize) is the OTHER consume-time overlay: an object-member branch is
      // DRIVEN from the merged stub view, so an object specimen asserting driven cases imports it too.
      "@assayer/core/stub-realize": [
        "../../../packages/core/src/brokers/stub/realize/stub-realize-broker"
      ],
      // Imported-type resolution is the consume-time overlay that runs FIRST: a parameter declared as an
      // imported type is `any` in the hermetic walk, so a specimen reading a sibling's shape imports it
      // to show the parameter typed as its declaration says.
      "@assayer/core/param-type-resolve": [
        "../../../packages/core/src/brokers/param-type/resolve/param-type-resolve-broker"
      ],
      // The cross-file example rungs assert their MODULE GRAPH — the raw imports/re-exports and the
      // references into imported names the walk records for a later stitch to resolve — which is a
      // projection of the walk, so it too rides alongside the walk adapter.
      "@assayer/core/module-graph": [
        "../../../packages/core/src/transformers/module-graph-projection/module-graph-projection-transformer"
      ],
      // The harness overlay is the LAST consume-time one: an entry whose input the fill seam refused is
      // re-derived with the colocated harness's value bound to its key path, so a specimen proving its
      // gap is paid imports it beside the analyze-file broker.
      "@assayer/core/harness-realize": [
        "../../../packages/core/src/brokers/harness/realize/harness-realize-broker"
      ],
      // The BARE specifier, and the only one a consumer's own committed code uses: a colocated
      // `<basename>.harness.ts` imports `assayerHarness` from it, exactly as the input-gap invoice
      // instructs. It resolves to core's MAIN barrel, which publishes that seam and nothing else.
      "@assayer/core": ["../../../packages/core/index.ts"],
      "@assayer/shared/contracts": ["../../../packages/shared/src/contracts/contracts"]
    }
  },
  "include": ["src/**/*"]
}
