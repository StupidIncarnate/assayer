{
  "framework": "monorepo",
  "orchestrationMode": "node",
  "schema": "zod",
  "orchestration": {
    "slotCount": 3,
    "timeoutMs": 900000
  },
  "dungeonmaster": {
    "port": 3737
  },
  "devServer": {
    "devCommand": "npm run dev",
    "port": 3738,
    "buildCommand": "npm run build",
    "readinessPath": "/",
    "readinessTimeoutMs": 30000,
    "e2e": {
      "processes": [
        {
          "name": "app",
          "command": "npm run dev:no-watch",
          "portRole": "api",
          "readyPath": "/",
          "env": {
            "PORT": "{apiPort}"
          }
        }
      ]
    }
  },
  "gateway": {}
}
